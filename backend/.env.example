# ---------------------------------------------------------------------------
# AssetFlow — variáveis de ambiente (todas opcionais)
# ---------------------------------------------------------------------------
# Precedência: variável de ambiente > config/*.yaml > padrão do código.
# Nenhuma decisão de motor/modelo/device fica hardcoded (plano §65).
# ---------------------------------------------------------------------------

# --- Caminhos --------------------------------------------------------------
# ASSETFLOW_CONFIG_DIR=./config
# ASSETFLOW_DATA_DIR=./data
# ASSETFLOW_STORAGE_ROOT=./data/assets
# ASSETFLOW_HISTORY_FILE=./data/history/generations.jsonl

# --- Gavetas ---------------------------------------------------------------
# Sobrepõem o campo `enabled` de config/engines.yaml (lista por vírgula).
# ASSETFLOW_ENGINES_ENABLED=mock-image-v1
# ASSETFLOW_ENGINES_DISABLED=diffusers-sdxl-v1

# --- Worker ----------------------------------------------------------------
# Com GPU, prefira false e suba o worker como processo separado (plano §34).
# ASSETFLOW_WORKER_EMBEDDED=true
# ASSETFLOW_WORKER_CONCURRENCY=1
# ASSETFLOW_JOB_TIMEOUT_S=900
# ASSETFLOW_JOB_MAX_ATTEMPTS=2
# Filas por capacidade (plano §33):
# ASSETFLOW_QUEUE_ROUTES=text_to_image.pixel=generation.pixel,text_to_image.general=generation.studio

# --- API -------------------------------------------------------------------
# ASSETFLOW_API_TITLE=AssetFlow Generation API
# ASSETFLOW_API_ROOT_PATH=
# ASSETFLOW_CORS_ORIGINS=http://localhost:3000
# ASSETFLOW_HOST=127.0.0.1
# ASSETFLOW_PORT=8000
# ASSETFLOW_LOG_LEVEL=INFO
